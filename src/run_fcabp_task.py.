import argparse
import os
import time
import numpy as np
import pandas as pd

try:
    from src.adaptive_staircase import AdaptiveStaircase
    from src.bids_logger import BIDSLogger
    from src.hardware_interface import HardwareInterface
except ImportError:
    from adaptive_staircase import AdaptiveStaircase
    from bids_logger import BIDSLogger
    from hardware_interface import HardwareInterface


def generate_trial_evidence(ambiguity: float, ground_truth: str, rng: np.random.Generator) -> dict:
    n_cues = 10
    signal_prob = 0.5 + 0.45 * (1.0 - ambiguity)
    if ground_truth == "BELIEF":
        p_true = signal_prob
    elif ground_truth == "DISBELIEF":
        p_true = 1.0 - signal_prob
    else:
        p_true = 0.50

    supporting = int(rng.binomial(n_cues, p_true))
    contradicting = n_cues - supporting
    return {
        "supporting_cues": supporting,
        "contradicting_cues": contradicting,
        "cue_ratio_str": f"{supporting} SUPPORT  |  {contradicting} CONTRADICT",
    }


def score_asymmetric_bet(choice: str, ground_truth: str, stake: int) -> tuple[bool, int]:
    if choice == "SUSPEND":
        is_correct = ground_truth == "SUSPEND"
        payoff = int(round(0.4 * stake))
        return is_correct, payoff

    is_correct = choice == ground_truth
    payoff = stake if is_correct else -(2 * stake)
    return is_correct, payoff


def sample_fixation_jitter(rng: np.random.Generator, min_s: float = 2.0, max_s: float = 6.5, mean_s: float = 3.5) -> float:
    """Truncated exponential inter-trial fixation jitter (2.0-6.5 s) for pCASL/BOLD HRF deconvolution."""
    val = min_s + rng.exponential(scale=(mean_s - min_s))
    return float(np.clip(val, min_s, max_s))


def run_cli_session(
    subject: str,
    session: str,
    n_trials: int,
    out_dir: str,
    seed: int = 42,
    config_path: str | None = None,
    wait_for_scanner: bool = False,
    use_jitter: bool = False,
):
    hw = HardwareInterface(config_path=config_path)
    logger = BIDSLogger(out_dir=out_dir, subject=subject, session=session)

    rng = np.random.default_rng(seed)
    stim_path = os.path.join(os.path.dirname(__file__), "..", "stimuli", "proposition_bank.csv")
    stim_df = pd.read_csv(stim_path)

    staircase = AdaptiveStaircase(initial_ambiguity=float(hw.cfg["experiment"]["initial_ambiguity"]))

    print("=" * 72)
    print(f"TSSM-FCABP PROTOCOL | Subject: {subject} | Session: {session} | Trials: {n_trials}")
    print(
        f"Trigger Mode: {hw.mode.upper()} | Jitter: {'ON (2.0-6.5s)' if use_jitter else 'OFF'} | "
        f"Keys: [{hw.key_map['belief']}]=BELIEF  [{hw.key_map['disbelief']}]=DISBELIEF  "
        f"[{hw.key_map['suspend']}]=SUSPEND  [{hw.key_map['quit_key']}]=Quit"
    )
    print("=" * 72)

    if wait_for_scanner:
        sync_key = str(hw.cfg["hardware"]["scanner_sync_key"])
        while True:
            pulse = input(f"Waiting for MRI scanner sync trigger ('{sync_key}')... ").strip()
            if pulse == sync_key:
                break

    run_start = time.perf_counter()

    try:
        for t_idx in range(1, n_trials + 1):
            row = stim_df.sample(n=1, random_state=int(rng.integers(0, 1_000_000))).iloc[0]
            ambiguity = staircase.current_ambiguity
            evidence = generate_trial_evidence(ambiguity, row["ground_truth_label"], rng)

            t_fix = hw.send_trigger("FIXATION_ONSET")
            jitter_sec = sample_fixation_jitter(rng) if use_jitter else 0.0
            if use_jitter:
                time.sleep(jitter_sec)

            stim_onset = time.perf_counter() - run_start
            t_prop = hw.send_trigger("PROPOSITION_ONSET")

            print(f"\n[Trial {t_idx:02d}/{n_trials:02d}] Ambiguity={ambiguity:.2f} | Stake=±{row['pragmatic_stake']} pts")
            print(f"  Proposition : {row['proposition_text']}")
            print(f"  Sample Cues : {evidence['cue_ratio_str']}")

            t0 = time.perf_counter()
            choice = None
            while choice is None:
                raw = input(
                    f"  Your choice ([{hw.key_map['belief']}]=Belief, [{hw.key_map['disbelief']}]=Disbelief, "
                    f"[{hw.key_map['suspend']}]=Suspend, [{hw.key_map['quit_key']}]=Quit): "
                )
                choice = hw.translate_response(raw)

            rt_sec = time.perf_counter() - t0

            if choice == "QUIT":
                print("Session terminated early by user.")
                break

            t_resp = hw.send_trigger(f"RESP_{choice}")
            is_correct, payoff = score_asymmetric_bet(choice, row["ground_truth_label"], int(row["pragmatic_stake"]))
            next_ambiguity = staircase.update(is_correct)
            t_fb = hw.send_trigger("FEEDBACK_ONSET")

            print(f"  -> Recorded: {choice} | RT={rt_sec*1000:.0f} ms | Payoff={payoff:+d} pts")

            logger.log_trial({
                "onset": round(stim_onset, 4),
                "duration": round(rt_sec, 4),
                "trial_type": choice,
                "trial_number": t_idx,
                "stim_id": row["stim_id"],
                "domain": row["domain"],
                "ground_truth": row["ground_truth_label"],
                "choice": choice,
                "response_time_ms": round(rt_sec * 1000.0, 2),
                "is_correct": int(is_correct),
                "payoff": payoff,
                "ambiguity_level": round(ambiguity, 4),
                "next_ambiguity_level": round(next_ambiguity, 4),
                "fixation_jitter_s": round(jitter_sec, 4),
                "trigger_codes": f"{t_fix},{t_prop},{t_resp},{t_fb}",
            })
    finally:
        out_file = logger.flush()
        hw.close()
        if out_file:
            print(f"\n[Saved] BIDS-compliant event log + JSON sidecar written to: {out_file}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the TSSM Forced-Choice Asymmetric Betting Paradigm (FCABP).")
    parser.add_argument("--subject", type=str, default="sub-01")
    parser.add_argument("--session", type=str, default="ses-01")
    parser.add_argument("--trials", type=int, default=12)
    parser.add_argument("--out-dir", type=str, default="data")
    parser.add_argument("--seed", type=int, default=42)
    parser.add_argument("--config", type=str, default=None)
    parser.add_argument("--wait-scanner", action="store_true", help="Pause until scanner sync trigger arrives")
    parser.add_argument("--jitter", action="store_true", help="Enable 2.0-6.5s exponential fixation jitter for fMRI/ASL")
    args = parser.parse_args()

    run_cli_session(
        subject=args.subject,
        session=args.session,
        n_trials=args.trials,
        out_dir=args.out_dir,
        seed=args.seed,
        config_path=args.config,
        wait_for_scanner=args.wait_scanner,
        use_jitter=args.jitter,
    )


if __name__ == "__main__":
    main()
            
