import argparse
import os
import time
from datetime import datetime
import numpy as np
import pandas as pd

from adaptive_staircase import AdaptiveStaircase


TRIGGERS = {
    "FIXATION_ONSET": 10,
    "PROPOSITION_ONSET": 20,
    "RESP_BELIEF": 31,
    "RESP_DISBELIEF": 32,
    "RESP_SUSPEND": 33,
    "FEEDBACK_ONSET": 40,
}


def generate_trial_evidence(ambiguity: float, ground_truth: str, rng: np.random.Generator) -> dict:
    n_cues = 10
    signal_prob = 0.5 + 0.45 * (1.0 - ambiguity)
    if ground_truth == "BELIEF":
        p_true = signal_prob
    elif ground_truth == "DISBELIEF":
        p_true = 1.0 - signal_prob
    else:
        p_true = 0.50

    supporting = int(rng.binomial(n_cues, p_true))
    contradicting = n_cues - supporting
    return {
        "supporting_cues": supporting,
        "contradicting_cues": contradicting,
        "cue_ratio_str": f"{supporting} SUPPORT  |  {contradicting} CONTRADICT",
    }


def score_asymmetric_bet(choice: str, ground_truth: str, stake: int) -> tuple[bool, int]:
    if choice == "SUSPEND":
        is_correct = ground_truth == "SUSPEND"
        payoff = int(round(0.4 * stake))
        return is_correct, payoff

    is_correct = (choice == ground_truth)
    payoff = stake if is_correct else -(2 * stake)
    return is_correct, payoff


def run_cli_session(subject: str, session: str, n_trials: int, out_dir: str, seed: int = 42):
    rng = np.random.default_rng(seed)
    stim_path = os.path.join(os.path.dirname(__file__), "..", "stimuli", "proposition_bank.csv")
    stim_df = pd.read_csv(stim_path)

    staircase = AdaptiveStaircase(initial_ambiguity=0.45)
    os.makedirs(out_dir, exist_ok=True)
    run_start = time.perf_counter()
    records = []

    print("=" * 72)
    print(f"TSSM-FCABP PROTOCOL | Subject: {subject} | Session: {session} | Trials: {n_trials}")
    print("Keys: [1] BELIEF (Affirm)   [2] DISBELIEF (Reject)   [3] SUSPEND (Defer)   [q] Quit")
    print("=" * 72)

    key_map = {"1": "BELIEF", "2": "DISBELIEF", "3": "SUSPEND"}

    for t_idx in range(1, n_trials + 1):
        row = stim_df.sample(n=1, random_state=int(rng.integers(0, 1_000_000))).iloc[0]
        ambiguity = staircase.current_ambiguity
        evidence = generate_trial_evidence(ambiguity, row["ground_truth_label"], rng)

        stim_onset = time.perf_counter() - run_start
        print(f"\n[Trial {t_idx:02d}/{n_trials:02d}] Ambiguity={ambiguity:.2f} | Stake=±{row['pragmatic_stake']} pts")
        print(f"  Proposition : {row['proposition_text']}")
        print(f"  Sample Cues : {evidence['cue_ratio_str']}")

        t0 = time.perf_counter()
        raw = input("  Your choice ([1]=Belief, [2]=Disbelief, [3]=Suspend, [q]=Quit): ").strip().lower()
        rt_sec = time.perf_counter() - t0

        if raw == "q":
            print("Session terminated early by user.")
            break

        choice = key_map.get(raw, "SUSPEND")
        is_correct, payoff = score_asymmetric_bet(choice, row["ground_truth_label"], int(row["pragmatic_stake"]))
        next_ambiguity = staircase.update(is_correct)
        print(f"  -> Recorded: {choice} | RT={rt_sec*1000:.0f} ms | Payoff={payoff:+d} pts")

        records.append({
            "onset": round(stim_onset, 4),
            "duration": round(rt_sec, 4),
            "trial_number": t_idx,
            "stim_id": row["stim_id"],
            "domain": row["domain"],
            "ground_truth": row["ground_truth_label"],
            "choice": choice,
            "response_time_ms": round(rt_sec * 1000.0, 2),
            "is_correct": int(is_correct),
            "payoff": payoff,
            "ambiguity_level": round(ambiguity, 4),
            "next_ambiguity_level": round(next_ambiguity, 4),
            "trigger_codes": f"{TRIGGERS['FIXATION_ONSET']},{TRIGGERS['PROPOSITION_ONSET']},{TRIGGERS[f'RESP_{choice}']},{TRIGGERS['FEEDBACK_ONSET']}",
        })

    if records:
        out_df = pd.DataFrame(records)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        out_file = os.path.join(out_dir, f"{subject}_{session}_task-FCABP_events_{timestamp}.tsv")
        out_df.to_csv(out_file, sep="\t", index=False)
        print(f"\n[Saved] BIDS-compatible event log written to: {out_file}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Run the TSSM Forced-Choice Asymmetric Betting Paradigm (FCABP).")
    parser.add_argument("--subject", type=str, default="sub-01")
    parser.add_argument("--session", type=str, default="ses-01")
    parser.add_argument("--trials", type=int, default=12)
    parser.add_argument("--out-dir", type=str, default="data")
    parser.add_argument("--seed", type=int, default=42)
    args = parser.parse_args()

    run_cli_session(
        subject=args.subject,
        session=args.session,
        n_trials=args.trials,
        out_dir=args.out_dir,
        seed=args.seed,
    )
